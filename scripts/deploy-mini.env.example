# Copy to scripts/deploy-mini.env (gitignored) on a signing Mac.
AGENT_DEPLOY_HOST=user@mini.example
# Optional. Omit to use the normal SSH config/agent key selection.
AGENT_DEPLOY_KEY=$HOME/.ssh/id_ed25519
# Optional SHA-1 fingerprint or unambiguous identity name from
# `security find-identity -v -p codesigning`. Keep this private.
AGENT_DEPLOY_SIGNER=
